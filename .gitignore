# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# PyTorch models and checkpoints
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
# Atomic-save temp files (save_checkpoint writes <ckpt>.tmp then renames; a power loss can leave one)
*.pt.tmp

# Token-budget pretraining corpus (swi_llm/data/token_corpus.py; GBs, rebuilt/resumed locally)
prototype/swi_llm/data/.token_corpus/

# Logs and databases
errorLog/
*.log

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backups and temporary files
*.bak

# Data assets kept out of the public portfolio repo (third-party text / regenerated by the pipeline)
prototype/swi_llm/data/arxiv_papers/
cleaned_wikipedia.jsonl
cleaned_wikipedia_parquet/
# RAG index cache (rebuilt from knowledge_base/ on first search)
.rag_cache/

# Machine-local Claude Code permissions
.claude/settings.json
.claude/settings.local.json
