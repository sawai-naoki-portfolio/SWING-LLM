' 全図共通のスタイル。各 .puml から !include _style.iuml で読み込む
set separator none
skinparam defaultFontName "Noto Sans CJK JP"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5560
skinparam ArrowFontColor #4A5560
skinparam ArrowFontSize 11
skinparam TitleFontSize 18
skinparam TitleFontStyle bold
skinparam LegendBackgroundColor #F7F9FA
skinparam LegendBorderColor #C9D1D9
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #E0C068
skinparam PackageBorderColor #8A97A3
skinparam PackageBackgroundColor #FAFBFC
skinparam PackageFontStyle bold
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #2F6F5E
skinparam ClassHeaderBackgroundColor #E6F2EE
skinparam ClassAttributeIconSize 0
skinparam StereotypeCBackgroundColor #ADD1B2
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #2F6F5E
skinparam DatabaseBackgroundColor #E6F2EE
skinparam DatabaseBorderColor #2F6F5E
skinparam NodeBackgroundColor #F4F7F9
skinparam NodeBorderColor #8A97A3
skinparam ActorBorderColor #2F6F5E
skinparam ActorBackgroundColor #E6F2EE
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #2F6F5E
skinparam RectangleBorderColor #8A97A3
skinparam StateBackgroundColor #FFFFFF
skinparam StateBorderColor #2F6F5E
skinparam StateStartColor #2F6F5E
skinparam StateEndColor #2F6F5E
skinparam SequenceLifeLineBorderColor #8A97A3
skinparam SequenceParticipantBackgroundColor #E6F2EE
skinparam SequenceParticipantBorderColor #2F6F5E
skinparam SequenceActorBackgroundColor #E6F2EE
skinparam SequenceActorBorderColor #2F6F5E
skinparam SequenceGroupBackgroundColor #F1F4F7
skinparam SequenceGroupBorderColor #8A97A3
skinparam SequenceBoxBackgroundColor #FAFBFC
skinparam SequenceBoxBorderColor #C9D1D9
skinparam SequenceDividerBackgroundColor #EEF2F5
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #2F6F5E
